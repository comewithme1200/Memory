{
  "name": "quan-an-sang",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Ứng dụng quản lý bán đồ ăn sáng: đặt hàng, quản lý món, in hoá đơn, tổng kết số lượng mỗi món.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:clean": "node scripts/build-clean.mjs",
    "check:env": "node scripts/check-build-env.mjs",
    "preview": "vite preview --port 4173",
    "check": "node scripts/check-supabase.mjs",
    "check:qr": "node scripts/check-qr-schema.mjs",
    "check:options": "node scripts/check-options-schema.mjs",
    "test:price": "node scripts/test-order-price.mjs",
    "test:item-price": "node scripts/test-item-price.mjs",
    "test:payment": "node scripts/test-payment.mjs",
    "seed:options": "node scripts/seed-options.mjs",
    "test:local": "node scripts/test-customers-local.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "deploy": "npm run build:clean && npm run check:env && gh-pages -d dist"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "gh-pages": "^6.3.0",
    "vite": "^8.3.5"
  }
}
