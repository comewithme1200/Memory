# =====================================================================
# Copy file này thành .env (cho local) rồi điền thông tin thật:
#   Windows (PowerShell/CMD):  copy .env.example .env
#   macOS / Linux:             cp .env.example .env
#
# Lấy key tại: Supabase Dashboard -> Project Settings -> API
# =====================================================================

# --- Kết nối Supabase (BẮT BUỘC để chạy thật) ---
# Project URL, ví dụ: https://abcdefghijklm.supabase.co
VITE_SUPABASE_URL=https://xxxxxxx.supabase.co

# anon public key (dài, bắt đầu bằng "eyJ")
# TUYỆT ĐỐI KHÔNG dùng service_role key ở đây.
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Tài khoản chủ quán (CHỈ dùng cho script kiểm tra `npm run check`) ---
# Điền 2 dòng này thì `npm run check` mới kiểm tra được phần "quyền ghi dữ liệu
# của chủ quán" (thêm/sửa/xoá món, xem & sửa đơn). Bỏ trống thì phần đó bị skip.
#
# Lưu ý: 2 dòng này KHÔNG được commit — .env đã nằm trong .gitignore.
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# --- Mật khẩu chủ quán ---
# Chỉ dùng khi CHƯA kết nối Supabase (chế độ demo).
# Khi đã kết nối Supabase, dùng tài khoản trong Authentication -> Users.
VITE_ADMIN_PIN=1234

# --- Thông tin quán hiển thị trên hoá đơn ---
VITE_SHOP_NAME=Quán Ăn Sáng
VITE_SHOP_ADDRESS=123 Nguyễn Văn A, Quận 1
VITE_SHOP_PHONE=0909 000 000

# --- QR ngân hàng (ảnh khách quét để chuyển khoản) ---
# Copy ảnh QR thật vào thư mục `public/` với tên `bank-qr.png` là dùng được.
# Muốn dùng tên/đường dẫn khác thì sửa dòng này (đường dẫn tương đối so với
# thư mục gốc của trang). Bỏ trống -> app dùng `public/bank-qr.png`, nếu cũng
# không có thì hiện ảnh placeholder kèm hướng dẫn.
VITE_BANK_QR_URL=
